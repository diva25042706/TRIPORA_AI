# ==============================================================================
# TRIPORA.AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Core Application Settings
PROJECT_NAME="TRIPORA.AI"
API_V1_STR="api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Development: SQLite
DATABASE_URL="sqlite:///./tripora.db"
# Production: PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/tripora"

# Multi-Agent LLM Orchestrator
# Options: "demo" (deterministic high-fidelity offline model), "gemini", "openai", "anthropic"
LLM_PROVIDER="demo"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Meteorological Provider
# (Open-Meteo operates keyless by default for global coordinates)
OPENWEATHER_API_KEY=""

# System Defaults
DEFAULT_CURRENCY="INR"
DEMO_MODE=true

# Frontend Configuration (place in frontend/.env if customizing)
VITE_API_URL="http://127.0.0.1:8000/api/v1"
